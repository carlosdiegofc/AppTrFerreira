# Build used by the end-to-end tests: talks to the local stand-in of tests/e2e/server.mjs, never to production.
VITE_SUPABASE_URL=http://127.0.0.1:8791/sb
VITE_SUPABASE_KEY=local-e2e
# A made-up Google Maps key: the tests answer for Google (mapa.spec.ts), so the satellite view can be checked.
VITE_GOOGLE_MAPS_KEY=clave-de-prueba
