<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TRF" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/trf_brand</item>
        <item name="colorPrimaryDark">@color/trf_brand</item>
        <item name="colorAccent">@color/trf_accent</item>
        <item name="alertDialogTheme">@style/TRF.Dialog</item>
        <!-- The colour of the room behind the glass, while the app opens. -->
        <item name="android:windowBackground">@color/trf_room</item>
    </style>

    <!-- The questions of the app, like the panel's dialogs: nearly solid, with big rounded corners (decision of 28/10/2026). -->
    <style name="TRF.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/trf_accent</item>
        <item name="android:windowBackground">@drawable/dialog_window</item>
        <item name="buttonBarPositiveButtonStyle">@style/TRF.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TRF.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/TRF.DialogButton</item>
    </style>

    <style name="TRF.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/trf_accent</item>
    </style>

    <!-- The sheets that come up from the bottom: they rise as they appear and sink when they close. -->
    <style name="TRF.SheetMotion" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
